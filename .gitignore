# Python bytecode from tools/*.py
__pycache__/
*.pyc

# Scratch renders from headless captures (preview/_foo.png). Deliberate
# artifacts — shot-*.png, boot-swipe.png, livery.png, wordmark-study.png,
# harness-dark.png, harness-light.png, boot-*.png — do not match this pattern.
preview/_*.png

# Build outputs. `package/` is the shippable bundle and `_tools/boot-sample.css`
# is the boot row the visual harness renders; both are generated by
#   node tools/build-package.js
# and are installed into the DSH profile by tools/install.ps1.
package/
_tools/boot-sample.css

# OS noise
Thumbs.db
desktop.ini
.DS_Store

